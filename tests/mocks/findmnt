#!/usr/bin/env bash
# Test double for findmnt; mounts are "DEV TARGET OPTIONS" lines in $MOCK_STATE/mounts.
f="$MOCK_STATE/mounts"; touch "$f"
mode=""; key=""
while (( $# )); do
  case "$1" in -S) mode=S; key="$2"; shift 2 ;; -M) mode=M; key="$2"; shift 2 ;; -T) mode=T; key="$2"; shift 2 ;; -o) shift 2 ;; *) shift ;; esac
done
if [[ "$mode" == T ]]; then echo "${MOCK_SHM_FSTYPE:-tmpfs}"; exit 0; fi
if [[ "$mode" == S ]]; then
  awk -v d="$key" '$1 == d { print $2; found = 1 } END { exit !found }' "$f"
else
  awk -v m="$key" -v t="${MOCK_FINDMNT_FSTYPE:-exfat}" '$2 == m { print $1, t, "/", $3; found = 1 } END { exit !found }' "$f"
fi
